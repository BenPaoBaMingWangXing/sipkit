///|
test "RFC 4475 corpus: every asserted vector reaches its required verdict" {
  let failures : Array[String] = []
  let mut asserted = 0
  let mut policy = 0
  for v in vectors {
    if v.expect == "policy" {
      policy = policy + 1
      continue
    }
    asserted = asserted + 1
    let input = bytes_from_hex(v.hex)
    let a = analyze(input)
    let actual = a.verdict().to_string()
    if actual != v.expect {
      failures.push("\{v.id}(\{v.section}) expected \{v.expect} got \{actual}")
    }
  }
  if failures.length() > 0 {
    let mut msg = "\{failures.length()} of \{asserted} vectors failed:"
    for f in failures {
      msg = msg + " | " + f
    }
    fail(msg)
  }
  // Guard against a silently shrinking suite.
  assert_true(asserted >= 45)
  assert_eq(policy, 4)
}

///|
test "RFC 4475 corpus: accepted vectors round-trip byte-for-byte" {
  let failures : Array[String] = []
  for v in vectors {
    if v.expect != "well-formed" || v.id == "mpart01" {
      continue
    }
    let input = bytes_from_hex(v.hex)
    let a = analyze(input)
    match a.message() {
      Some(msg) => {
        // dblreq carries a second message after the first body; only the
        // consumed prefix is expected to round-trip.
        let consumed = msg.consumed()
        let rebuilt = to_bytes(msg)
        let prefix = input.view(start=0, end=consumed)
        if hex_of(rebuilt.view()) != hex_of(prefix.view()) {
          failures.push("\{v.id}: round-trip mismatch")
        }
        if msg.trailing().length() > 0 && v.id != "dblreq" {
          failures.push("\{v.id}: unexpected trailing octets")
        }
      }
      None => failures.push("\{v.id}: did not parse")
    }
  }
  if failures.length() > 0 {
    let mut msg = "\{failures.length()} round-trip failures:"
    for f in failures {
      msg = msg + " | " + f
    }
    fail(msg)
  }
}
