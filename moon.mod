// Module metadata for sipkit.
//
// `name` is the MoonCakes module id and matches the GitHub repository
// (github.com/BenPaoBaMingWangXing/sipkit), so the repository name, the module
// name and the README title are the same string.

name = "BenPaoBaMingWangXing/sipkit"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/BenPaoBaMingWangXing/sipkit"

license = "Apache-2.0"

keywords = [
  "sip",
  "rfc3261",
  "rfc4475",
  "parser",
  "protocol",
  "voip",
  "diagnostics",
  "conformance",
]

preferred_target = "wasm"

description = "Sans-IO SIP message parsing, canonical re-emission and conformance diagnostics for MoonBit, validated against the IETF RFC 4475 torture-test corpus."
